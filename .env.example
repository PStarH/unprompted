# Unprompted configuration example.
#
# Copy to `.env` (or export these in your shell) and fill in what you need.
# Environment values are optional because the interface can save your model
# and Google connection locally. Normal mode waits for real context; no sample
# is played after model setup.
# npm run demo is the separate rule-only example; it makes no model calls.
#
# Never commit real values. `.env` is git-ignored.

# ---------------------------------------------------------------- server ----
# PORT=4173
# Host is fixed to 127.0.0.1; this prototype does not bind a public interface.
# UNPROMPTED_STATE_FILE=./data/state.json
# Optional HTTP limits; defaults and advanced tuning are in docs/CONFIGURATION.md.
# UNPROMPTED_HTTP_MAX_BODY_BYTES=1048576
# UNPROMPTED_HTTP_BODY_TIMEOUT_MS=30000
# UNPROMPTED_HTTP_BODY_IDLE_TIMEOUT_MS=10000
# UNPROMPTED_HTTP_REQUEST_TIMEOUT_MS=35000
# UNPROMPTED_HTTP_MAX_SSE_CLIENTS=32
# UNPROMPTED_HTTP_SSE_MAX_FRAME_BYTES=8388608
# UNPROMPTED_HTTP_SSE_MAX_CLIENT_BUFFER_BYTES=10485760
# UNPROMPTED_HTTP_SSE_MAX_TOTAL_BUFFER_BYTES=67108864
# UNPROMPTED_HTTP_SSE_HEARTBEAT_MS=20000
# Simulation is only started when runtime mode is simulation; this flag cannot
# inject simulated events into a live Google workspace.
# UNPROMPTED_FORCE_SIMULATION=false
# Legacy polling interval, in milliseconds. New installs should use the
# Connections → Continuous observation settings panel instead.
# UNPROMPTED_SYNC_INTERVAL_MS=0
# Hard ceiling for one connector pull (ms); a timed-out pull commits no cursor.
# UNPROMPTED_SYNC_TIMEOUT_MS=120000

# How long a request may sit with no observable progress before the decision to
# provide information or close it reaches the user (milliseconds; default 24h).
# A stalled request eventually needs an actionable decision.
# UNPROMPTED_STALL_AFTER_MS=86400000

# How often the attention sweep runs (milliseconds; default 60000, min 15000).
# The sweep is read-only unless a stall or deadline is actually due.
# UNPROMPTED_ATTENTION_SWEEP_MS=60000

# How numeric dates in messages are read. Only this explicit setting (or an
# in-app answer to the calibration question) decides between month/day and
# day/month; nothing guesses from the machine, an IP address or the text.
# Accepted: MM/DD or DD/MM. Leave unset to keep genuinely ambiguous dates
# (10/11) marked as ambiguous — they never fire a deadline warning until the
# reading is stated. A single-reading date (10/18, 31/12) resolves either way.
# UNPROMPTED_DATE_LOCALE=MM/DD

# --------------------------------------------------------- model provider ----
# Prefer the in-app Verify and connect flow. For launch-environment setup:
# primary makes the model interpret requests even when rules recognize them;
# evidence, permissions and execution verification remain engine responsibilities.
# UNPROMPTED_MODEL_BASE_URL=https://api.openai.com/v1
# UNPROMPTED_MODEL_NAME=your-model-id
# UNPROMPTED_MODEL_API_KEY=
# UNPROMPTED_MODEL_ROLE=primary
# Explicit rule-only HTTP/engine contract mode, for fixtures and integration
# development. This is not the main model-backed product experience.
# UNPROMPTED_RULE_ONLY=false
# Agent harness: classic (default) or pi (bounded, task-scoped read-tool loop).
# Pi requires Node.js 22.19+ and npm ci --include=optional.
# UNPROMPTED_AGENT_HARNESS=pi
# Brief concurrency bursts wait in a bounded queue; this does not retry failed calls.
# UNPROMPTED_MODEL_MAX_CALLS_PER_MINUTE=20
# UNPROMPTED_MODEL_MAX_QUEUED=32
# UNPROMPTED_MODEL_QUEUE_TIMEOUT_MS=20000
# Set MAX_QUEUED or QUEUE_TIMEOUT_MS to 0 for immediate concurrency refusal.

# ----------------------------------------------------- Google Workspace ------
# Required for live Gmail / Drive / Docs sync. Obtain a refresh token with the
# scopes listed in docs/LIVE_INTEGRATION.md. All three values must be present
# before live mode is enabled; normal startup waits for connection.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_ACCOUNT_EMAIL=

# Gmail search used for the initial bounded query, e.g. newer_than:3d -in:chats
# GOOGLE_GMAIL_QUERY=

# Turn either read scope off if you only want one half of the workspace.
# GOOGLE_READ_GMAIL=true
# GOOGLE_READ_DRIVE=true

# Sending is OFF unless you explicitly opt in AND grant the gmail.send scope
# AND turn shadow mode off. Without this, live mode is read-only: the system
# can still discover, correlate and prepare work, but it cannot deliver anything.
# GOOGLE_SEND_ENABLED=false

# Google Docs patch writes have their own independent opt-in and OAuth scope.
# The account must grant documents or drive.file; Gmail send authorization does
# not authorize document writes. The in-app authorization panel manages scopes.
# GOOGLE_DOCS_WRITE_ENABLED=false

# Per-request timeout for Google API calls (ms). A request that never returns is
# aborted and the cursor is not advanced.
# GOOGLE_REQUEST_TIMEOUT_MS=20000

# Total time budget for one connector pull (ms). Once exceeded, no further
# requests start; the sync reports a retryable failure and keeps its cursor.
# GOOGLE_SYNC_BUDGET_MS=120000

# Idempotent GET retry policy for Google requests. POST (send) is never retried.
# GOOGLE_MAX_RETRIES=2
# GOOGLE_RETRY_BASE_MS=500

# Hard cap on a Drive document export. Larger documents are refused rather than
# buffered without bound; the sync reports a non-retryable error.
# GOOGLE_MAX_DOCUMENT_CHARS=1000000

# Read-only shadow mode. Default is on (any value other than false). External
# writes are refused at the permission policy and at the Gmail send method,
# even if a send scope and an approval are both present. Set false only to
# restore the previous simulated or explicitly enabled send path.
# UNPROMPTED_SHADOW_MODE=true

# A distribution may provision its registered Desktop OAuth client once.
# End users then choose their account in Google consent without Cloud setup.
# Never include a user's refresh token in a distributed client file.
# UNPROMPTED_GOOGLE_DESKTOP_CLIENT_FILE=/path/to/desktop-client.json
# Or provide UNPROMPTED_GOOGLE_DESKTOP_CLIENT_ID and
# UNPROMPTED_GOOGLE_DESKTOP_CLIENT_SECRET. Google review is still required
# for public restricted-scope distribution unless an exception applies.

# Additional read-only sources use official device OAuth. Register the public
# application once; end users never paste access tokens or client secrets.
# UNPROMPTED_GITHUB_CLIENT_ID=your-registered-github-app-client-id
# UNPROMPTED_MICROSOFT_CLIENT_ID=your-registered-microsoft-application-id
# Or use a JSON file containing github.clientId / microsoft.clientId:
# UNPROMPTED_CONNECTOR_CLIENTS_FILE=/path/to/connector-clients.json
