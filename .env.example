# Unprompted configuration example.
#
# Copy to `.env` (or export these in your shell) and fill in what you need.
# EVERY value here is optional: with none of them set, the application runs the
# deterministic local simulation and contacts no external service.
#
# Never commit real values. `.env` is git-ignored.

# ---------------------------------------------------------------- server ----
# PORT=4173
# Host is fixed to 127.0.0.1; this prototype does not bind a public interface.
# UNPROMPTED_STATE_FILE=./data/state.json
# Replay the local simulation even when Google credentials are present.
# UNPROMPTED_FORCE_SIMULATION=false
# How often to poll live connectors, in milliseconds. 0 disables polling.
# Values below 15000 are clamped. Prefer push notifications where available.
# UNPROMPTED_SYNC_INTERVAL_MS=0
# Hard ceiling for one connector pull (ms); a timed-out pull commits no cursor.
# UNPROMPTED_SYNC_TIMEOUT_MS=120000

# How long a request may sit with no observable progress before the decision to
# provide information or close it reaches the user (milliseconds; default 24h).
# A stalled request eventually needs an actionable decision.
# UNPROMPTED_STALL_AFTER_MS=86400000

# How often the attention sweep runs (milliseconds; default 60000, min 15000).
# The sweep is read-only unless a stall or deadline is actually due.
# UNPROMPTED_ATTENTION_SWEEP_MS=60000

# How numeric dates in messages are read. Only this explicit setting (or an
# in-app answer to the calibration question) decides between month/day and
# day/month; nothing guesses from the machine, an IP address or the text.
# Accepted: MM/DD or DD/MM. Leave unset to keep genuinely ambiguous dates
# (10/11) marked as ambiguous — they never fire a deadline warning until the
# reading is stated. A single-reading date (10/18, 31/12) resolves either way.
# UNPROMPTED_DATE_LOCALE=MM/DD

# ------------------------------------------------- optional model provider ----
# Used ONLY to interpret a request the deterministic pass could not make
# verifiable. Leave blank to stay fully deterministic. There is no fallback
# that fabricates a decision if this provider is unreachable.
# UNPROMPTED_MODEL_BASE_URL=https://api.openai.com/v1
# UNPROMPTED_MODEL_NAME=your-model-id
# UNPROMPTED_MODEL_API_KEY=

# ----------------------------------------------------- Google Workspace ------
# Required for live Gmail / Drive / Docs sync. Obtain a refresh token with the
# scopes listed in docs/LIVE_INTEGRATION.md. All three values must be present
# before live mode is enabled; until then the simulation stays active.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_ACCOUNT_EMAIL=

# Gmail search used for the initial bounded query, e.g. newer_than:3d -in:chats
# GOOGLE_GMAIL_QUERY=

# Turn either read scope off if you only want one half of the workspace.
# GOOGLE_READ_GMAIL=true
# GOOGLE_READ_DRIVE=true

# Sending is OFF unless you explicitly opt in AND grant the gmail.send scope
# AND turn shadow mode off. Without this, live mode is read-only: the system
# can still discover, correlate and prepare work, but it cannot deliver anything.
# GOOGLE_SEND_ENABLED=false

# Per-request timeout for Google API calls (ms). A request that never returns is
# aborted and the cursor is not advanced.
# GOOGLE_REQUEST_TIMEOUT_MS=20000

# Total time budget for one connector pull (ms). Once exceeded, no further
# requests start; the sync reports a retryable failure and keeps its cursor.
# GOOGLE_SYNC_BUDGET_MS=120000

# Idempotent GET retry policy for Google requests. POST (send) is never retried.
# GOOGLE_MAX_RETRIES=2
# GOOGLE_RETRY_BASE_MS=500

# Hard cap on a Drive document export. Larger documents are refused rather than
# buffered without bound; the sync reports a non-retryable error.
# GOOGLE_MAX_DOCUMENT_CHARS=1000000

# Read-only shadow mode. Default is on (any value other than false). External
# writes are refused at the permission policy and at the Gmail send method,
# even if a send scope and an approval are both present. Set false only to
# restore the previous simulated or explicitly enabled send path.
# UNPROMPTED_SHADOW_MODE=true
